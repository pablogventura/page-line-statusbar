            <prop oor:name="URL" oor:type="xs:string"><value>vnd.foja:intervencion_rev</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value>Inter.(Rev) - Ctrl+F12</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
