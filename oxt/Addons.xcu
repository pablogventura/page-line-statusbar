<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data
  xmlns:oor="http://openoffice.org/2001/registry"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  oor:name="Addons"
  oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBar">
      <node oor:name="org.foja.writer.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="es">Foja</value>
          <value xml:lang="en">Foja</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.text.TextDocument</value>
        </prop>
        <node oor:name="Submenu">
          <node oor:name="m_nro" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string"><value>vnd.foja:nro_letras</value></prop>
            <prop oor:name="Title" oor:type="xs:string"><value>De N a Letras</value></prop>
            <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          </node>
        </node>
      </node>
    </node>

    <node oor:name="OfficeToolBar">
      <node oor:name="org.foja.writer.toolbar" oor:op="replace">
        <node oor:name="tb_nro" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>vnd.foja:nro_letras</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value>N a Letras</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
      </node>
    </node>

    <node oor:name="OfficeStatusbarMerging">
      <node oor:name="org.foja.writer.statusbar" oor:op="replace">
        <node oor:name="org.foja.writer.statusbar.merge1" oor:op="replace">
          <prop oor:name="MergePoint" oor:type="xs:string">
            <value>.uno:StatePageNumber</value>
          </prop>
          <prop oor:name="MergeCommand" oor:type="xs:string">
            <value>AddAfter</value>
          </prop>
          <prop oor:name="MergeFallback" oor:type="xs:string">
            <value>AddLast</value>
          </prop>
          <prop oor:name="MergeContext" oor:type="xs:string">
            <value/>
          </prop>
          <node oor:name="StatusBarItems">
            <node oor:name="org.foja.writer.pagelin" oor:op="replace">
              <prop oor:name="URL" oor:type="xs:string">
                <value>vnd.foja:status</value>
              </prop>
              <prop oor:name="Title" oor:type="xs:string">
                <value xml:lang="en">Pag - - Lin -</value>
                <value xml:lang="es">Pag - - Lin -</value>
              </prop>
              <prop oor:name="Context" oor:type="xs:string">
                <value/>
              </prop>
              <prop oor:name="Alignment" oor:type="xs:string">
                <value>left</value>
              </prop>
              <prop oor:name="AutoSize" oor:type="xs:boolean">
                <value>false</value>
              </prop>
              <prop oor:name="OwnerDraw" oor:type="xs:boolean">
                <value>false</value>
              </prop>
              <prop oor:name="Mandatory" oor:type="xs:boolean">
                <value>true</value>
              </prop>
              <prop oor:name="Width" oor:type="xs:long">
                <value>120</value>
              </prop>
            </node>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
